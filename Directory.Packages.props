<Project>
  <ItemGroup>
    <!-- MIT (Microsoft.Data.Sqlite.Core), Apache-2.0 (SQLitePCLRaw), Apache-2.0 (xunit.v3), BSD-2-Clause (Jint, tests only). -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0" />
    <!-- SQLite is Windows' own winsqlite3.dll (System32): no e_sqlite3.dll ships beside the exe. Microsoft.Data.Sqlite.Core 11 needs SQLitePCLRaw.core 3, so the provider moves to 3 with it (no code change in core or this provider). -->
    <PackageVersion Include="SQLitePCLRaw.provider.winsqlite3" Version="3.0.5" />
    <PackageVersion Include="Jint" Version="4.18.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
